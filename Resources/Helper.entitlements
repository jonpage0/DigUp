<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The indexing helper (Contents/Helpers/digup) reads a Photos library's pictures, the files osxphotos names, to
	     index them: under the hardened runtime that takes this, besides the permission macOS asks you for. -->
	<key>com.apple.security.personal-information.photos-library</key>
	<true/>
</dict>
</plist>
